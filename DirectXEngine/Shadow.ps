////////////////////////////////////////////////////////////////////////////////
// Filename: shadow.ps
////////////////////////////////////////////////////////////////////////////////


/////////////
// GLOBALS //
/////////////
Texture2D shaderTexture : register(t0);

Texture2D depthMapTexture : register(t1);
Texture2D depthMapTexture2 : register(t2);
Texture2D depthMapTexture3 : register(t3);
Texture2D directionalDepthMap : register(t4);

SamplerState SampleTypeClamp : register(s0);
SamplerState SampleTypeWrap : register(s1);


//////////////
// TYPEDEFS //
//////////////
struct PixelInputType
{
    float4 position : SV_POSITION;
    float2 tex : TEXCOORD0;
    float3 normal : NORMAL;
    float4 viewPosition : TEXCOORD1;
    float4 lightViewPosition : TEXCOORD2;
    float3 lightPos : TEXCOORD3;
    float4 lightViewPosition2 : TEXCOORD4;
    float3 lightPos2 : TEXCOORD5;
    float4 lightViewPosition3 : TEXCOORD6;
    float3 lightPos3 : TEXCOORD7;
    float4 directionalLightViewPosition : TEXCOORD8;
};


//////////////////////
// CONSTANT BUFFERS //
//////////////////////
cbuffer LightBuffer
{
    float4 ambientColor;
    float4 diffuseColor;
    float4 diffuseColor2;
    float4 diffuseColor3;
    float bias;
    float3 directionalLightDirection;
};

////////////////////////////////////////////////////////////////////////////////
// Pixel Shader
////////////////////////////////////////////////////////////////////////////////
float4 ShadowPixelShader(PixelInputType input) : SV_TARGET
{
    float4 color;
    float2 projectTexCoord;
    float depthValue;
    float lightDepthValue;
    float lightIntensity;
    float4 textureColor;
    float3 directionalLightDir;

    // Set the default output color to the ambient light value for all pixels.
    color = ambientColor;

    input.normal = normalize(input.normal);
    

    /////////////////////
    // directional light //
    ////////////////////
    
    directionalLightDir = -directionalLightDirection;
    
    // Calculate the amount of light on this pixel.
    lightIntensity = saturate(dot(input.normal, directionalLightDir));
    
    // Calculate the projected texture coordinates.
    projectTexCoord.x = input.lightViewPosition.x / input.lightViewPosition.w / 2.0f + 0.5f;
    projectTexCoord.y = -input.lightViewPosition.y / input.lightViewPosition.w / 2.0f + 0.5f;
    
    depthValue = directionalDepthMap.Sample(SampleTypeClamp, projectTexCoord).r;
    color += (diffuseColor * lightIntensity) * depthValue;
    color = saturate(color);
    
    /*
    else
    {
        // If this is outside the area of shadow map range then draw things normally with regular lighting.
        lightIntensity = saturate(dot(input.normal, directionalLightDir));
        if(lightIntensity > 0.0f)
        {
            color += (diffuseColor * lightIntensity);
            //color = saturate(color);
        }
    }*/

     ////////////////
    // first light //
    ////////////////
    
    
    // Calculate the amount of light on this pixel.
    lightIntensity = saturate(dot(input.normal, input.lightPos));
    
    // Calculate the projected texture coordinates.
    projectTexCoord.x = input.lightViewPosition.x / input.lightViewPosition.w / 2.0f + 0.5f;
    projectTexCoord.y = -input.lightViewPosition.y / input.lightViewPosition.w / 2.0f + 0.5f;
    
    depthValue = depthMapTexture.Sample(SampleTypeClamp, projectTexCoord).r;
    //color += (diffuseColor * lightIntensity) * depthValue;
    //color = saturate(color);
    
    ////////////////
    // Second light //
    ////////////////
    
    // Calculate the amount of light on this pixel.
    lightIntensity = saturate(dot(input.normal, input.lightPos2));
    
    // Calculate the projected texture coordinates.
    projectTexCoord.x = input.lightViewPosition.x / input.lightViewPosition.w / 2.0f + 0.5f;
    projectTexCoord.y = -input.lightViewPosition.y / input.lightViewPosition.w / 2.0f + 0.5f;
    
    depthValue = depthMapTexture2.Sample(SampleTypeClamp, projectTexCoord).r;
    //color += (diffuseColor2 * lightIntensity) * depthValue;
    //color = saturate(color);

    
     ////////////////
    // third light //
    ////////////////
    
    // Calculate the amount of light on this pixel.
    lightIntensity = saturate(dot(input.normal, input.lightPos3));
    
    // Calculate the projected texture coordinates.
    projectTexCoord.x = input.lightViewPosition.x / input.lightViewPosition.w / 2.0f + 0.5f;
    projectTexCoord.y = -input.lightViewPosition.y / input.lightViewPosition.w / 2.0f + 0.5f;
    
    depthValue = depthMapTexture3.Sample(SampleTypeClamp, projectTexCoord).r;
    //color += (diffuseColor3 * lightIntensity) * depthValue;
    //color = saturate(color);
    
    // Saturate the final light color.
    //color = saturate(color);

    // Sample the pixel color from the texture using the sampler at this texture coordinate location.
    textureColor = shaderTexture.Sample(SampleTypeWrap, input.tex);

    // Combine the light and texture color.
    color = color * textureColor;

    return color;
}