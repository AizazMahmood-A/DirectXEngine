    //float4 worldPos = mul(projectedPosition, invViewProjection);
    //worldPos /= worldPos.w;

    //float4 testPos = mul(worldPos, viewProjection);
    //float2 testUV = (testPos.xy / testPos.w) * 0.5 + 0.5;
    //testUV.y = 1 - testUV.y;